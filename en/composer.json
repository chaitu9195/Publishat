    "ext-mongodb": "*",
    "google/apiclient": "^2.15",
    "mongodb/mongodb": "^2.0",
    "phpoffice/phpspreadsheet": "^2.0",
    "phpseclib/phpseclib": "^3"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
